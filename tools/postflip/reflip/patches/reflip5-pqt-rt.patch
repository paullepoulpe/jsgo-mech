diff --git a/go/closure/rt_pqt.go b/go/closure/rt_pqt.go
new file mode 100644
index 000000000..f48c0c1bd
--- /dev/null
+++ b/go/closure/rt_pqt.go
@@ -0,0 +1,133 @@
+package closure
+
+import "unsafe"
+
+// A PriorityQueue made with a typed comparator (post-flip step 559, tools/postflip/tcmp).
+//
+// The translator gives an erased PriorityQueue the converting closure of a typed comparator
+// cmp: func(a, b any) int32 { return cmp(K(a), K(b)) }, K the cast of an Object to the element
+// type T. Every comparison of the heap then casts both elements again. newPriorityQueueT_ makes
+// the same queue (the same heap code, the same erased comparator for whoever asks for it) that
+// keeps, beside each element x, the value K(x) once it has been computed, and compares those
+// with cmp.
+//
+// What makes it the same queue: K is a pure cast (for the same interface value it returns the
+// same value or throws the same exception, and has no effect), so skipping a repeated K(x) is
+// not observable; K(x) is first evaluated exactly where the erased comparator first evaluated
+// it (compare(x, e) is K(x), K(e), cmp, in this order), so an element that is not a T throws
+// at the same call; cmp is called with the same pairs in the same order (siftUp and siftDown
+// below are PriorityQueue's, step for step). A kept value is used only for the identical
+// interface value (sameBox_), so no operation the queue inherits from ArrayList can make it
+// stale.
+
+// pqTyped_ is the typed side of a PriorityQueue: the two heap moves, on the queue's items.
+type pqTyped_ interface {
+	siftUp(es []any, k int, x any)
+	siftDown(es []any, k int, x any)
+}
+
+type pqEnt_[T any] struct {
+	x any // the element t was computed from (nil: none)
+	t T   // unbox(x)
+}
+
+type pqT_[T any] struct {
+	ents  []pqEnt_[T] // ents[k] belongs to items[k] while its x is the identical value
+	cmp   func(a, b T) int32
+	unbox func(any) T
+}
+
+// newPriorityQueueT_ is new PriorityQueue<>(c) for the converting closure c of cmp and unbox:
+// with a null cmp the closure is null and the queue orders naturally.
+func newPriorityQueueT_[T any](cmp Comparator[T], unbox func(any) T) *PriorityQueue {
+	if cmp == nil {
+		return new_PriorityQueue(nil)
+	}
+	this := new_PriorityQueue(func(a, b any) int32 { return cmp(unbox(a), unbox(b)) })
+	this.typed = &pqT_[T]{cmp: cmp, unbox: unbox}
+	return this
+}
+
+// sameBox_ reports whether a and b are the identical interface value (type word and data word).
+func sameBox_(a, b any) bool {
+	return *(*[2]uintptr)(unsafe.Pointer(&a)) == *(*[2]uintptr)(unsafe.Pointer(&b))
+}
+
+// start makes ents as long as the items and returns the kept value of x, the element being
+// placed, when the entry just past the items is x's (poll and removeAt take the last element
+// off before they place it).
+func (m *pqT_[T]) start(n int, x any) (tx T, have bool) {
+	if len(m.ents) > n {
+		if e := &m.ents[n]; e.x != nil && sameBox_(e.x, x) {
+			tx, have = e.t, true
+		}
+		clear(m.ents[n:])
+		m.ents = m.ents[:n]
+	}
+	for len(m.ents) < n {
+		m.ents = append(m.ents, pqEnt_[T]{})
+	}
+	return tx, have
+}
+
+// val is unbox(es[k]), computed unless kept.
+func (m *pqT_[T]) val(es []any, k int) T {
+	e := &m.ents[k]
+	if x := es[k]; e.x == nil || !sameBox_(e.x, x) {
+		t := m.unbox(x)
+		e.x, e.t = x, t
+	}
+	return e.t
+}
+
+func (m *pqT_[T]) put(k int, x any, tx T, have bool) {
+	if have {
+		m.ents[k] = pqEnt_[T]{x, tx}
+	} else {
+		m.ents[k] = pqEnt_[T]{}
+	}
+}
+
+func (m *pqT_[T]) siftUp(es []any, k int, x any) {
+	tx, have := m.start(len(es), x)
+	for k > 0 {
+		parent := (k - 1) >> 1
+		if !have {
+			tx, have = m.unbox(x), true
+		}
+		if m.cmp(tx, m.val(es, parent)) >= 0 {
+			break
+		}
+		es[k] = es[parent]
+		m.ents[k] = m.ents[parent]
+		k = parent
+	}
+	es[k] = x
+	m.put(k, x, tx, have)
+}
+
+func (m *pqT_[T]) siftDown(es []any, k int, x any) {
+	tx, have := m.start(len(es), x)
+	n := len(es)
+	half := n >> 1
+	for k < half {
+		child := 2*k + 1
+		if right := child + 1; right < n {
+			tv := m.val(es, child)
+			if m.cmp(tv, m.val(es, right)) > 0 {
+				child = right
+			}
+		}
+		if !have {
+			tx, have = m.unbox(x), true
+		}
+		if m.cmp(tx, m.val(es, child)) <= 0 {
+			break
+		}
+		es[k] = es[child]
+		m.ents[k] = m.ents[child]
+		k = child
+	}
+	es[k] = x
+	m.put(k, x, tx, have)
+}
diff --git a/go/closure/rt_pqt_test.go b/go/closure/rt_pqt_test.go
new file mode 100644
index 000000000..07712cd62
--- /dev/null
+++ b/go/closure/rt_pqt_test.go
@@ -0,0 +1,100 @@
+package closure
+
+import (
+	"fmt"
+	"math/rand"
+	"testing"
+)
+
+type pqtItem_ struct{ pri, id int32 }
+
+// TestPriorityQueueTyped: a queue made by newPriorityQueueT_ and the erased queue given the
+// converting closure do the same thing: the same results of every operation, the same calls of
+// the comparator and of the cast in the same order (a repeated cast of the same element
+// aside), the same exception at the same call for an element that is not a T.
+func TestPriorityQueueTyped(t *testing.T) {
+	type trace struct {
+		cmps  []string
+		casts map[any]bool
+		out   []string
+	}
+	mk := func(tr *trace) (func(a, b *pqtItem_) int32, func(v any) *pqtItem_) {
+		cmp := func(a, b *pqtItem_) int32 {
+			tr.cmps = append(tr.cmps, fmt.Sprint(a.id, "/", b.id))
+			return Integer_compare(a.pri, b.pri)
+		}
+		unbox := func(v any) *pqtItem_ {
+			tr.casts[v] = true
+			return cast_[*pqtItem_](v)
+		}
+		return cmp, unbox
+	}
+	for seed := int64(1); seed <= 20; seed++ {
+		var ta, tb trace
+		ta.casts, tb.casts = map[any]bool{}, map[any]bool{}
+		ca, ua := mk(&ta)
+		cb, ub := mk(&tb)
+		erased := new_PriorityQueue(func(p0 any, p1 any) int32 { return ca(ua(p0), ua(p1)) })
+		typed := newPriorityQueueT_[*pqtItem_](cb, ub)
+		r := rand.New(rand.NewSource(seed))
+		var live []*pqtItem_
+		step := func(tr *trace, q *PriorityQueue, op int, it *pqtItem_, bad any) {
+			defer func() {
+				if e := recover(); e != nil {
+					tr.out = append(tr.out, fmt.Sprintf("throws %T", e))
+				}
+			}()
+			switch op {
+			case 0:
+				q.add(it)
+				tr.out = append(tr.out, "add")
+			case 1:
+				v := q.poll()
+				tr.out = append(tr.out, fmt.Sprint("poll ", v))
+			case 2:
+				tr.out = append(tr.out, fmt.Sprint("remove ", q.remove_Object(it)))
+			case 3:
+				q.clear()
+				tr.out = append(tr.out, "clear")
+			case 4:
+				q.add(bad)
+				tr.out = append(tr.out, "add bad")
+			case 5:
+				tr.out = append(tr.out, fmt.Sprint("peek ", q.peek(), " size ", q.size()))
+			}
+		}
+		for i := 0; i < 400; i++ {
+			op := []int{0, 0, 0, 1, 1, 2, 5, 0, 1, 0}[r.Intn(10)]
+			if i%97 == 96 {
+				op = 3
+			}
+			if seed%5 == 0 && i == 150 {
+				op = 4
+			}
+			it := &pqtItem_{pri: int32(r.Intn(12)), id: int32(i)}
+			if op == 2 && len(live) > 0 {
+				it = live[r.Intn(len(live))]
+			}
+			if op == 0 {
+				live = append(live, it)
+			}
+			step(&ta, erased, op, it, "not an item")
+			step(&tb, typed, op, it, "not an item")
+			if fmt.Sprint(erased.items) != fmt.Sprint(typed.items) {
+				t.Fatalf("seed %d step %d: items differ", seed, i)
+			}
+		}
+		if fmt.Sprint(ta.out) != fmt.Sprint(tb.out) {
+			t.Fatalf("seed %d: results differ", seed)
+		}
+		if fmt.Sprint(ta.cmps) != fmt.Sprint(tb.cmps) {
+			t.Fatalf("seed %d: comparator calls differ (%d, %d)", seed, len(ta.cmps), len(tb.cmps))
+		}
+		if len(ta.casts) != len(tb.casts) {
+			t.Fatalf("seed %d: elements cast differ (%d, %d)", seed, len(ta.casts), len(tb.casts))
+		}
+	}
+	if q := newPriorityQueueT_[*pqtItem_](nil, cast_[*pqtItem_]); q.cmp != nil || q.typed != nil {
+		t.Fatal("a null comparator: the natural-order queue")
+	}
+}

+// nodePropFront_ holds the lists of nodePropLists_ that were asked for last, one per slot of a
+// hash of the key: a walk over a tree asks for the lists of the same few shapes of one source
+// file again and again, and a slot answers with a comparison where the map hashes the key. A
+// list of nodePropLists_ is never replaced, so a slot cannot go stale.
+const nodePropFrontBits_ = 10
+
+var nodePropFront_ [1 << nodePropFrontBits_]struct {
+	key nodePropListKey_
+	l   *Node_PropListItem
+}

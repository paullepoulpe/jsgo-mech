+// sortTListF_ is List.sort(c) / Collections.sort(list, c) of l.asList() with a typed comparator
+// cmp (tools/postflip/tcmp): the items of a mutable list are sorted as sortSliceF_ sorts them,
+// the comparisons List_sort made on the view's boxes, written back once the sort has returned.
+// An immutable list, and a nil one, go through List_sort as before (an immutable list's twin
+// is sorted in a copy and the first write back throws UnsupportedOperationException), with cmp
+// over the unboxed elements.
+func sortTListF_[T any](l *TList[T], cmp func(a, b T) int32) {
+	if l == nil || l.imm {
+		var c Comparator
+		if l != nil {
+			c = &cmpFunc_{func(a, b any) int32 { return cmp(l.c.unbox(a), l.c.unbox(b)) }}
+		}
+		List_sort(l.asList(), c)
+		return
+	}
+	sortSliceF_(l.items, cmp)
+}

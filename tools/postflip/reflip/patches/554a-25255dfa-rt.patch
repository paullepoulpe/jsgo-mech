new file mode 100644
index 00000000..b95ad976
--- /dev/null
+++ b/go/closure/rt_tstep.go
@@ -0,0 +1,37 @@
+package closure
+
+// The erased views of the typed collections as steppers (stepper_, rt_coll.go): a for-each
+// loop over one (foreach_, elems_) reads it by position with the loop's own cursor, where
+// iterator() makes an iterator object (and, for a map's views, the views it goes through) for
+// every loop. Each step reads what the view's iterator reads at that step: the list's items or
+// the map's keys as they are now, a removed entry of a map skipped, the element boxed as the
+// view boxes it.
+
+func (v *tlistView_[T]) step_(i int) (any, int) {
+	l := v.l
+	if i >= len(l.items) {
+		return nil, -1
+	}
+	return l.c.box(l.items[i]), i + 1
+}
+
+// tmapStep_ is the step of a view of m whose elements are out(m, i).
+func tmapStep_[K comparable, V any](m *TMap[K, V], i int, out func(m *TMap[K, V], i int32) any) (any, int) {
+	if i == 0 {
+		i = m.first()
+	}
+	for i < len(m.keys) && m.isDead(i) {
+		i++
+	}
+	if i >= len(m.keys) {
+		return nil, -1
+	}
+	return out(m, int32(i)), i + 1
+}
+
+func (v *tkeysView_[K, V]) step_(i int) (any, int)    { return tmapStep_(v.m, i, keyOut_[K, V]) }
+func (v *tvalsView_[K, V]) step_(i int) (any, int)    { return tmapStep_(v.m, i, valOut_[K, V]) }
+func (v *tentriesView_[K, V]) step_(i int) (any, int) { return tmapStep_(v.m, i, entryOut_[K, V]) }
+func (v *tsetView_[K]) step_(i int) (any, int) {
+	return tmapStep_(v.m, i, keyOut_[K, struct{}])
+}
diff --git a/go/closure/rt_tstep_test.go b/go/closure/rt_tstep_test.go
new file mode 100644
index 00000000..593088a8
--- /dev/null
+++ b/go/closure/rt_tstep_test.go
@@ -0,0 +1,109 @@
+package closure
+
+import (
+	"fmt"
+	"testing"
+)
+
+// A for-each loop over the erased view of a typed collection reads by position what the
+// view's iterator reads, also when the loop's body changes the collection.
+func TestTypedViewSteppers(t *testing.T) {
+	show := func(v any) string {
+		if e, ok := v.(Map_Entry); ok {
+			return fmt.Sprint(e.getKey(), "=", e.getValue())
+		}
+		return fmt.Sprint(v)
+	}
+	walk := func(c any, viaIter bool, body func(n int)) string {
+		out := ""
+		n := 0
+		if viaIter {
+			for it := c.(Iterable).iterator(); it.hasNext(); n++ {
+				out += show(it.next()) + ";"
+				body(n)
+			}
+			return out
+		}
+		e := foreach_(c)
+		if e.at == nil {
+			t.Fatalf("%T is read through an iterator object", c)
+		}
+		for ; e.next(); n++ {
+			out += show(e.v) + ";"
+			body(n)
+		}
+		return out
+	}
+	type views struct {
+		name string
+		mk   func() (view any, grow func(), cut func())
+	}
+	strs := func(n int) []string {
+		var s []string
+		for i := 0; i < n; i++ {
+			s = append(s, fmt.Sprint("k", i))
+		}
+		return s
+	}
+	mkMap := func(pick func(m Map) any) func() (any, func(), func()) {
+		return func() (any, func(), func()) {
+			m := newTMap_(tc_string, tc_string)
+			for _, k := range strs(40) {
+				m.Put(k, "v"+k)
+			}
+			for _, k := range strs(7) { // removed entries at the head and inside
+				m.asMap().remove(strobj_(k))
+			}
+			m.asMap().remove(strobj_("k20"))
+			return pick(m.asMap()), func() { m.Put(fmt.Sprint("n", m.asMap().size()), "x") }, func() { m.asMap().remove(strobj_("k30")) }
+		}
+	}
+	cases := []views{
+		{"list", func() (any, func(), func()) {
+			l := newTList_(tc_string)
+			for _, k := range strs(12) {
+				l.add(k)
+			}
+			return l.asList(), func() { l.add("n") }, func() { l.removeAt(l.size() - 1) }
+		}},
+		{"empty list", func() (any, func(), func()) {
+			l := newTList_(tc_string)
+			return l.asList(), func() {}, func() {}
+		}},
+		{"set", func() (any, func(), func()) {
+			s := newTSet_(tc_string)
+			for _, k := range strs(40) {
+				s.Add(k)
+			}
+			for _, k := range strs(5) {
+				s.asSet().remove_Object(strobj_(k))
+			}
+			return s.asSet(), func() { s.Add(fmt.Sprint("n", s.asSet().size())) }, func() { s.asSet().remove_Object(strobj_("k30")) }
+		}},
+		{"keys", mkMap(func(m Map) any { return m.keySet() })},
+		{"values", mkMap(func(m Map) any { return m.values() })},
+		{"entries", mkMap(func(m Map) any { return m.entrySet() })},
+	}
+	for _, c := range cases {
+		for _, change := range []string{"none", "grow", "cut"} {
+			var got [2]string
+			for i, viaIter := range []bool{true, false} {
+				view, grow, cut := c.mk()
+				got[i] = walk(view, viaIter, func(n int) {
+					if n == 3 && change == "grow" {
+						grow()
+					}
+					if n == 3 && change == "cut" {
+						cut()
+					}
+				})
+			}
+			if got[0] != got[1] {
+				t.Errorf("%s (%s): iterator %q, for-each %q", c.name, change, got[0], got[1])
+			}
+			if change == "none" && c.name != "empty list" && got[1] == "" {
+				t.Errorf("%s: nothing read", c.name)
+			}
+		}
+	}
+}

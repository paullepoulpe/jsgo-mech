+func TestUnifiedFamily(t *testing.T) {
+	got := uOneFamily_()
+	for i := 0; i < len(got) || i < len(unifyGolden_); i++ {
+		var g, w string
+		if i < len(got) {
+			g = got[i]
+		}
+		if i < len(unifyGolden_) {
+			w = unifyGolden_[i]
+		}
+		if g != w {
+			t.Errorf("line %d:\n   the one family: %s\n  the translator's: %s", i, g, w)
+		}
+	}
+}

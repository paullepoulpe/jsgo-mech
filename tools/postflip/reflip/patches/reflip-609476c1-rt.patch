diff --git a/go/closure/rt_jbridge.go b/go/closure/rt_jbridge.go
new file mode 100644
index 00000000..2f2795c3
--- /dev/null
+++ b/go/closure/rt_jbridge.go
@@ -0,0 +1,191 @@
+package closure
+
+// What the typed sets and maps the translator writes use and the post-flip typed set and map
+// (rt_tmap.go) did not have, for post-flip tool jfam -kind keyed: with these a *JTSet[K] is a
+// *TSet[K] and a *JTMap[K, V] a *TMap[K, V] (the translator's own, rt_jtset.go and rt_jtmap.go,
+// keep serving code that still names them). Each is the translator's function on the
+// post-flip representation: the same results, exceptions and iteration order.
+
+// newTSetCap_ is new LinkedHashSet<>(n), newTMapCap_ new LinkedHashMap<>(n): n is evaluated and
+// not used, as in the translator's newTSetN_ and newTMapN_.
+func newTSetCap_[K comparable](c *tconv_[K], n int32) *TSet[K] { return newTSet_(c) }
+
+func newTMapCap_[K comparable, V any](kc *tconv_[K], vc *tconv_[V], n int32) *TMap[K, V] {
+	return newTMap_(kc, vc)
+}
+
+// tmapFromMap_ is new LinkedHashMap<>(from): NullPointerException for a null map.
+func tmapFromMap_[K comparable, V any](kc *tconv_[K], vc *tconv_[V], from Map) *TMap[K, V] {
+	m := newTMap_(kc, vc)
+	if from == nil {
+		panic(new_NullPointerException_0().self())
+	}
+	m.asMap().putAll(from)
+	return m
+}
+
+// iterator is the set's Iterator (of boxed elements, with remove), as its view's; a null set
+// throws NullPointerException.
+func (s *TSet[K]) iterator() Iterator {
+	if s == nil {
+		panic(new_NullPointerException_0().self())
+	}
+	return s.asSet().iterator()
+}
+
+// putAllT is putAll of another typed map of the same types.
+func (m *TMap[K, V]) putAllT(o *TMap[K, V]) {
+	for i, k := range o.keys {
+		if !o.isDead(i) {
+			m.Put(k, o.vals[i])
+		}
+	}
+}
+
+// tmapKeysP_ is the cursor of a for-each loop over the keys of a typed map, tmapValsP_ over its
+// values, tmapEntriesP_ over its entries: the mappings in insertion order, read position by
+// position as the erased cursor reads its table.
+type tmapKeysP_[K comparable, V any] struct {
+	m *TMap[K, V]
+	i int
+	v K
+}
+
+// eachKey is the cursor of a for-each loop over keySet(); a null map throws
+// NullPointerException here, where the loop asked for the key set.
+func (m *TMap[K, V]) eachKey() tmapKeysP_[K, V] {
+	_ = m.live
+	return tmapKeysP_[K, V]{m: m}
+}
+
+func (e *tmapKeysP_[K, V]) next() bool {
+	m := e.m
+	for e.i < len(m.keys) {
+		i := e.i
+		e.i++
+		if !m.isDead(i) {
+			e.v = m.keys[i]
+			return true
+		}
+	}
+	return false
+}
+
+type tmapValsP_[K comparable, V any] struct {
+	m *TMap[K, V]
+	i int
+	v V
+}
+
+// eachValue is the cursor of a for-each loop over values().
+func (m *TMap[K, V]) eachValue() tmapValsP_[K, V] {
+	_ = m.live
+	return tmapValsP_[K, V]{m: m}
+}
+
+func (e *tmapValsP_[K, V]) next() bool {
+	m := e.m
+	for e.i < len(m.keys) {
+		i := e.i
+		e.i++
+		if !m.isDead(i) {
+			e.v = m.vals[i]
+			return true
+		}
+	}
+	return false
+}
+
+type tmapEntriesP_[K comparable, V any] struct {
+	m *TMap[K, V]
+	i int
+}
+
+// eachEntry is the cursor of a for-each loop over entrySet().
+func (m *TMap[K, V]) eachEntry() tmapEntriesP_[K, V] {
+	_ = m.live
+	return tmapEntriesP_[K, V]{m: m}
+}
+
+func (e *tmapEntriesP_[K, V]) next() bool {
+	m := e.m
+	for e.i < len(m.keys) {
+		e.i++
+		if !m.isDead(e.i - 1) {
+			return true
+		}
+	}
+	return false
+}
+
+// entry is the entry the cursor is at: an object of its own, as each entry of the Java map is.
+func (e *tmapEntriesP_[K, V]) entry() *TEntryP[K, V] {
+	i := e.i - 1
+	return &TEntryP[K, V]{m: e.m, i: int32(i), k: e.m.keys[i], v: e.m.vals[i]}
+}
+
+// TEntryP is an entry of a typed map (Map.Entry<K, V>) in a for-each loop over its entries (the
+// translator's TEntry on the post-flip map). It reads and writes the value of its mapping while
+// the map has it; after the mapping's removal it keeps the last value, as the entry of the
+// erased map does.
+type TEntryP[K comparable, V any] struct {
+	m *TMap[K, V]
+	i int32
+	k K
+	v V
+}
+
+// pos is the position of the entry's mapping in the map, or -1 if the map has it no more.
+func (e *TEntryP[K, V]) pos() int32 {
+	m := e.m
+	if i := int(e.i); i < len(m.keys) && m.keys[i] == e.k && !m.isDead(i) {
+		return e.i
+	}
+	return m.find(e.k)
+}
+
+func (e *TEntryP[K, V]) getKey() K { return e.k }
+
+func (e *TEntryP[K, V]) getValue() V {
+	if i := e.pos(); i >= 0 {
+		e.v = e.m.vals[i]
+	}
+	return e.v
+}
+
+func (e *TEntryP[K, V]) setValue(v V) V {
+	old := e.getValue()
+	e.v = v
+	if i := e.pos(); i >= 0 {
+		e.m.vals[i] = v
+	}
+	return old
+}
+
+// asEntry is the entry as an erased Map.Entry (nil for null).
+func (e *TEntryP[K, V]) asEntry() Map_Entry {
+	if e == nil {
+		return nil
+	}
+	return &tentryViewP_[K, V]{e: e}
+}
+
+// tentryViewP_ is a TEntryP seen as an erased Map.Entry.
+type tentryViewP_[K comparable, V any] struct {
+	e *TEntryP[K, V]
+}
+
+func (v *tentryViewP_[K, V]) self() any     { return v }
+func (v *tentryViewP_[K, V]) getKey() any   { return v.e.m.kc.box(v.e.k) }
+func (v *tentryViewP_[K, V]) getValue() any { return v.e.m.vc.box(v.e.getValue()) }
+func (v *tentryViewP_[K, V]) setValue(x any) any {
+	return v.e.m.vc.box(v.e.setValue(v.e.m.vc.unbox(x)))
+}
+func (v *tentryViewP_[K, V]) equals(o any) bool {
+	x, ok := o.(Map_Entry)
+	return ok && x != nil && objequals_(v.getKey(), x.getKey()) && objequals_(v.getValue(), x.getValue())
+}
+func (v *tentryViewP_[K, V]) hashCode() int32 { return objhash_(v.getKey()) ^ objhash_(v.getValue()) }
+func (v *tentryViewP_[K, V]) toString() string {
+	return objstr_(v.getKey()) + "=" + objstr_(v.getValue())
+}
diff --git a/go/closure/rt_jbridge_test.go b/go/closure/rt_jbridge_test.go
new file mode 100644
index 00000000..f66eb6a7
--- /dev/null
+++ b/go/closure/rt_jbridge_test.go
@@ -0,0 +1,105 @@
+package closure
+
+import "testing"
+
+// The bridge between the translator's typed collections and the post-flip ones (rt_jbridge.go,
+// jtconv_.t_): conversions, cursors, entries and constructors behave as the translator's did.
+func TestJBridge(t *testing.T) {
+	npe := func(f func()) (thrown bool) {
+		defer func() {
+			if r := recover(); r != nil {
+				_, thrown = r.(*NullPointerException)
+			}
+		}()
+		f()
+		return false
+	}
+	str := func(byEquals bool) *jtconv_[string] {
+		return &jtconv_[string]{box: func(v string) any { return strobj_(v) }, unbox: func(v any) string { return str_(v) }, null: nullstr_, byEquals: byEquals}
+	}
+	// One post-flip conversion per translator conversion; hash and eq only for byEquals.
+	plain, eq := str(false), str(true)
+	if plain.t_() != plain.t_() || plain.t_().hash != nil || plain.t_().eq != nil {
+		t.Fatal("t_ of a conversion compared by ==")
+	}
+	if eq.t_() != eq.t_() || eq.t_().hash == nil || eq.t_().eq == nil {
+		t.Fatal("t_ of a conversion compared by equals")
+	}
+	for _, kc := range []*tconv_[string]{plain.t_(), eq.t_()} {
+		m := newTMapCap_(kc, plain.t_(), 100)
+		keys := []string{"b", "a", "d", "c", "k5", "k6", "k7", "k8", "k9", "k10", "k11"} // more than tsmall_
+		for i, k := range keys {
+			if old := m.Put(k, k+"v"); old != nullstr_ {
+				t.Fatalf("put %d returned %q", i, old)
+			}
+		}
+		m.Delete("d")
+		var ks, vs []string
+		for it := m.eachKey(); it.next(); {
+			ks = append(ks, it.v)
+		}
+		for it := m.eachValue(); it.next(); {
+			vs = append(vs, it.v)
+		}
+		if len(ks) != len(keys)-1 || ks[0] != "b" || ks[2] != "c" || vs[2] != "cv" || len(vs) != len(ks) {
+			t.Fatalf("keys %v values %v", ks, vs)
+		}
+		// An entry reads and writes its mapping while the map has it, and keeps its last value
+		// after the mapping's removal.
+		n := 0
+		for it := m.eachEntry(); it.next(); n++ {
+			e := it.entry()
+			if e.getKey() != ks[n] || e.getValue() != ks[n]+"v" {
+				t.Fatalf("entry %d is %q=%q", n, e.getKey(), e.getValue())
+			}
+			if old := e.setValue("x" + e.getKey()); old != ks[n]+"v" || m.Get(e.getKey()) != "x"+e.getKey() {
+				t.Fatalf("setValue of entry %d", n)
+			}
+			if n == 1 {
+				view := e.asEntry()
+				if str_(view.getKey()) != "a" || str_(view.getValue()) != "xa" || objstr_(view) != "a=xa" {
+					t.Fatalf("erased entry %v", objstr_(view))
+				}
+				m.Delete("a")
+				if e.getValue() != "xa" || e.setValue("gone") != "xa" || e.getValue() != "gone" || m.Has("a") {
+					t.Fatal("an entry after its mapping's removal")
+				}
+			}
+		}
+		if n != len(ks) {
+			t.Fatalf("visited %d of %d entries", n, len(ks))
+		}
+		o := newTMap_(kc, plain.t_())
+		o.Put("z", "1")
+		o.putAllT(m)
+		if o.Len() != m.Len()+1 || o.Get("b") != "xb" {
+			t.Fatal("putAllT")
+		}
+		c := tmapFromMap_(kc, plain.t_(), m.asMap())
+		if c.Len() != m.Len() || c.Get("c") != "xc" {
+			t.Fatal("tmapFromMap_")
+		}
+		if !npe(func() { tmapFromMap_(kc, plain.t_(), nil) }) {
+			t.Fatal("tmapFromMap_ of null does not throw NullPointerException")
+		}
+		s := newTSetCap_(kc, 3)
+		for _, k := range keys {
+			s.Add(k)
+		}
+		var seen []string
+		for it := s.iterator(); it.hasNext(); {
+			k := str_(it.next())
+			seen = append(seen, k)
+			if k == "a" {
+				Iterator_remove(it)
+			}
+		}
+		if len(seen) != len(keys) || s.Has("a") || s.Len() != int32(len(keys)-1) {
+			t.Fatalf("set iterator: saw %v, %d left", seen, s.Len())
+		}
+		var null *TSet[string]
+		if !npe(func() { null.iterator() }) {
+			t.Fatal("iterator of a null set does not throw NullPointerException")
+		}
+	}
+}
diff --git a/go/closure/rt_jtlist.go b/go/closure/rt_jtlist.go
index 4f671b68..dc83cb23 100644
--- a/go/closure/rt_jtlist.go
+++ b/go/closure/rt_jtlist.go
@@ -31,6 +31,11 @@ type jtconv_[T any] struct {
 func (c *jtconv_[T]) t_() *tconv_[T] {
 	if c.post == nil {
 		c.post = &tconv_[T]{box: c.box, unbox: c.unbox, null: c.null}
+		if c.byEquals {
+			// Keys compared by equals and hashCode, through their boxes as teqFind_ compares them.
+			c.post.hash = func(k T) int32 { return objhash_(c.box(k)) }
+			c.post.eq = func(a, b T) bool { return objequals_(c.box(a), c.box(b)) }
+		}
 	}
 	return c.post
 }

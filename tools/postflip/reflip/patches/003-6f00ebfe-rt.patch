diff --git a/go/closure/rt_tlist.go b/go/closure/rt_tlist.go
new file mode 100644
index 00000000..566984ed
--- /dev/null
+++ b/go/closure/rt_tlist.go
@@ -0,0 +1,278 @@
+package closure
+
+import "reflect"
+
+// Typed lists (post-flip step 3): ArrayList<T> as a slice of T.
+//
+// A TList keeps its elements unboxed. Code that still expects an erased List gets asList(),
+// a view that boxes on the way out and unboxes on the way in; a list has one view, so its
+// identity is preserved across the boundary. Behaviour mirrors ArrayList in rt_coll.go,
+// exception messages included.
+
+// tconv_ converts the elements of one element type to and from their boxed form.
+type tconv_[T any] struct {
+	box   func(T) any
+	unbox func(any) T
+	null  T // Java's null as a T (the null string for strings, else the zero value)
+}
+
+type TList[T any] struct {
+	items []T
+	c     *tconv_[T]
+	view  *tlistView_[T]
+	imm   bool // an ImmutableList: every change throws UnsupportedOperationException
+}
+
+func newTList_[T any](c *tconv_[T]) *TList[T] { return &TList[T]{c: c} }
+
+func newTListN_[T any](c *tconv_[T], n int32) *TList[T] {
+	return &TList[T]{c: c, items: make([]T, 0, n)}
+}
+
+// tlistImm_ is an immutable list (ImmutableList.of, copyOf, build) as a typed list.
+func tlistImm_[T any](c *tconv_[T], from Collection) *TList[T] {
+	if isNil_(from) {
+		return nil
+	}
+	l := tlistFrom_(c, from)
+	l.imm = true
+	return l
+}
+
+// tlistFrom_ is new ArrayList<>(from) as a typed list.
+func tlistFrom_[T any](c *tconv_[T], from Collection) *TList[T] {
+	src := toSlice_(from)
+	l := &TList[T]{c: c, items: make([]T, len(src))}
+	for i, x := range src {
+		l.items[i] = c.unbox(x)
+	}
+	return l
+}
+
+func (l *TList[T]) size() int32   { return int32(len(l.items)) }
+func (l *TList[T]) isEmpty() bool { return len(l.items) == 0 }
+
+func (l *TList[T]) get(i int32) T {
+	if i < 0 || int(i) >= len(l.items) {
+		panic(new_IndexOutOfBoundsException_String("Index " + istr_(int64(i)) + " out of bounds for length " + istr_(int64(len(l.items)))).self())
+	}
+	return l.items[i]
+}
+
+func (l *TList[T]) set(i int32, v T) T {
+	if l.imm {
+		throwUOE_()
+	}
+	old := l.items[i]
+	l.items[i] = v
+	return old
+}
+
+func (l *TList[T]) add(v T) bool {
+	if l.imm {
+		throwUOE_()
+	}
+	l.items = append(l.items, v)
+	return true
+}
+
+func (l *TList[T]) insert(i int32, v T) {
+	if l.imm {
+		throwUOE_()
+	}
+	if i < 0 || int(i) > len(l.items) {
+		panic(new_IndexOutOfBoundsException_String("Index: " + istr_(int64(i)) + ", Size: " + istr_(int64(len(l.items)))).self())
+	}
+	var z T
+	l.items = append(l.items, z)
+	copy(l.items[i+1:], l.items[i:])
+	l.items[i] = v
+}
+
+func (l *TList[T]) clear() {
+	if l.imm {
+		throwUOE_()
+	}
+	clear(l.items)
+	l.items = l.items[:0]
+}
+
+func (l *TList[T]) removeAt(i int32) T {
+	if l.imm {
+		throwUOE_()
+	}
+	old := l.get(i)
+	var z T
+	if i == 0 {
+		l.items[0] = z
+		l.items = l.items[1:]
+		return old
+	}
+	copy(l.items[i:], l.items[i+1:])
+	l.items[len(l.items)-1] = z
+	l.items = l.items[:len(l.items)-1]
+	return old
+}
+
+func (l *TList[T]) trimToSize()            {}
+func (l *TList[T]) ensureCapacity(n int32) {}
+
+// each is the cursor of a for-each loop over the list (as each_ over an ArrayList: the
+// slice is read anew at every step).
+func (l *TList[T]) each() sliceEach_[T] { return sliceEach_[T]{src: &l.items} }
+
+// asList is the list as an erased List (nil for a nil list).
+func (l *TList[T]) asList() List {
+	if l == nil {
+		return nil
+	}
+	if l.view == nil {
+		l.view = &tlistView_[T]{l: l}
+	}
+	return l.view
+}
+
+// tlistView_ is a TList seen as an erased List.
+type tlistView_[T any] struct{ l *TList[T] }
+
+func (v *tlistView_[T]) boxed() []any {
+	out := make([]any, len(v.l.items))
+	for i, x := range v.l.items {
+		out[i] = v.l.c.box(x)
+	}
+	return out
+}
+
+func (v *tlistView_[T]) self() any                     { return v }
+func (v *tlistView_[T]) size() int32                   { return v.l.size() }
+func (v *tlistView_[T]) isEmpty() bool                 { return v.l.isEmpty() }
+func (v *tlistView_[T]) get(i int32) any               { return v.l.c.box(v.l.get(i)) }
+func (v *tlistView_[T]) set(i int32, x any) any        { return v.l.c.box(v.l.set(i, v.l.c.unbox(x))) }
+func (v *tlistView_[T]) add(x any) bool                { return v.l.add(v.l.c.unbox(x)) }
+func (v *tlistView_[T]) add_int_Object(i int32, x any) { v.l.insert(i, v.l.c.unbox(x)) }
+func (v *tlistView_[T]) remove(i int32) any            { return v.l.c.box(v.l.removeAt(i)) }
+func (v *tlistView_[T]) clear()                        { v.l.clear() }
+func (v *tlistView_[T]) trimToSize()                   {}
+
+func (v *tlistView_[T]) addAll(c Collection) bool {
+	if v.l.imm {
+		throwUOE_()
+	}
+	src := toSlice_(c)
+	for _, x := range src {
+		v.l.items = append(v.l.items, v.l.c.unbox(x))
+	}
+	return len(src) > 0
+}
+
+func (v *tlistView_[T]) indexOf(x any) int32 {
+	for i, y := range v.l.items {
+		if objequals_(x, v.l.c.box(y)) {
+			return int32(i)
+		}
+	}
+	return -1
+}
+
+func (v *tlistView_[T]) lastIndexOf(x any) int32 {
+	for i := len(v.l.items) - 1; i >= 0; i-- {
+		if objequals_(x, v.l.c.box(v.l.items[i])) {
+			return int32(i)
+		}
+	}
+	return -1
+}
+
+func (v *tlistView_[T]) contains(x any) bool { return v.indexOf(x) >= 0 }
+
+func (v *tlistView_[T]) containsAll(c Collection) bool {
+	for it := c.iterator(); it.hasNext(); {
+		if !v.contains(it.next()) {
+			return false
+		}
+	}
+	return true
+}
+
+func (v *tlistView_[T]) remove_Object(x any) bool {
+	i := v.indexOf(x)
+	if i < 0 {
+		return false
+	}
+	v.l.removeAt(i)
+	return true
+}
+
+func (v *tlistView_[T]) removeAll(c Collection) bool {
+	l := v.l
+	if l.imm {
+		throwUOE_()
+	}
+	out := l.items[:0]
+	for _, x := range l.items {
+		if !c.contains(l.c.box(x)) {
+			out = append(out, x)
+		}
+	}
+	changed := len(out) != len(l.items)
+	clear(l.items[len(out):])
+	l.items = out
+	return changed
+}
+
+func (v *tlistView_[T]) iterator() Iterator                { return &tlistIter_[T]{l: v.l} }
+func (v *tlistView_[T]) listIterator(i int32) ListIterator { return &tlistIter_[T]{l: v.l, i: int(i)} }
+
+func (v *tlistView_[T]) subList(a int32, b int32) List {
+	if a < 0 || b > v.l.size() || a > b {
+		panic(new_IndexOutOfBoundsException_String("fromIndex: " + istr_(int64(a)) + ", toIndex: " + istr_(int64(b)) + ", size: " + istr_(int64(len(v.l.items)))).self())
+	}
+	return listOf_(v.boxed()[a:b:b])
+}
+
+func (v *tlistView_[T]) toArray_0() []any      { return v.boxed() }
+func (v *tlistView_[T]) toArray(a []any) []any { return fillArray_(v.boxed(), a) }
+func (v *tlistView_[T]) equals(o any) bool     { return listEquals_(v.boxed(), o) }
+func (v *tlistView_[T]) hashCode() int32       { return listHash_(v.boxed()) }
+func (v *tlistView_[T]) toString() string      { return collToString_(v) }
+
+// tlistIter_ iterates over a TList for erased code (Iterator, with remove).
+type tlistIter_[T any] struct {
+	l *TList[T]
+	i int
+}
+
+func (it *tlistIter_[T]) hasNext() bool { return it.i < len(it.l.items) }
+
+func (it *tlistIter_[T]) next() any {
+	if it.i >= len(it.l.items) {
+		panic(new_NoSuchElementException_0().self())
+	}
+	v := it.l.items[it.i]
+	it.i++
+	return it.l.c.box(v)
+}
+
+func (it *tlistIter_[T]) remove() {
+	it.i--
+	it.l.removeAt(int32(it.i))
+}
+
+// isNil_ reports whether c is null: a nil interface or an interface holding a nil pointer (an
+// ImmutableList field that is null reaches the copy as the latter).
+func isNil_(c any) bool {
+	if c == nil {
+		return true
+	}
+	v := reflect.ValueOf(c)
+	return v.Kind() == reflect.Pointer && v.IsNil()
+}
+
+// addAllT is addAll from another typed list.
+func (l *TList[T]) addAllT(o *TList[T]) bool {
+	if l.imm {
+		throwUOE_()
+	}
+	l.items = append(l.items, o.items...)
+	return len(o.items) > 0
+}
diff --git a/go/closure/rt_tmap.go b/go/closure/rt_tmap.go
new file mode 100644
index 00000000..f777a37d
--- /dev/null
+++ b/go/closure/rt_tmap.go
@@ -0,0 +1,691 @@
+package closure
+
+// Typed maps and sets (post-flip step 4): LinkedHashMap<K, V> and LinkedHashSet<K> with
+// unboxed keys and values, for keys whose Java equality is Go's == (strings, handles, classes
+// without equals of their own).
+//
+// Insertion order is kept as in LinkedHashMap: keys and values in slices, removed positions
+// marked dead, a Go map from key to position once the table has more than tsmall_ entries.
+// Code that still expects an erased Map or Set gets asMap() / asSet(), a view with the
+// collection's identity. Behaviour mirrors rt_coll.go.
+
+const tsmall_ = 8
+
+type TMap[K comparable, V any] struct {
+	keys []K
+	vals []V
+	kc   *tconv_[K]
+	vc   *tconv_[V]
+	live int32
+	imm  bool
+	x    *tmapExt_[K, V] // what most maps never need; nil until then
+}
+
+// tmapExt_ holds the parts of a typed map that a small map never needs, so that the many small
+// maps and sets the compiler creates stay small (a TMap is 80 bytes).
+type tmapExt_[K comparable, V any] struct {
+	dead  []bool // beside keys once something was removed; else nil
+	idx   map[K]int32
+	ndead int32
+	view  *tmapView_[K, V]
+	sview *tsetView_[K]
+}
+
+func (m *TMap[K, V]) ext() *tmapExt_[K, V] {
+	if m.x == nil {
+		m.x = &tmapExt_[K, V]{}
+	}
+	return m.x
+}
+
+// isDead reports whether position i holds a removed entry.
+func (m *TMap[K, V]) isDead(i int) bool { return m.x != nil && m.x.dead != nil && m.x.dead[i] }
+
+func newTMap_[K comparable, V any](kc *tconv_[K], vc *tconv_[V]) *TMap[K, V] {
+	return &TMap[K, V]{kc: kc, vc: vc}
+}
+
+// tmapFrom_ is new LinkedHashMap<>(from) (or an ImmutableMap, imm) as a typed map.
+func tmapFrom_[K comparable, V any](kc *tconv_[K], vc *tconv_[V], from Map, imm bool) *TMap[K, V] {
+	if imm && isNil_(from) {
+		return nil
+	}
+	m := newTMap_(kc, vc)
+	for it := from.entrySet().iterator(); it.hasNext(); {
+		e := it.next().(Map_Entry)
+		m.put(kc.unbox(e.getKey()), vc.unbox(e.getValue()))
+	}
+	m.imm = imm
+	return m
+}
+
+func (m *TMap[K, V]) find(k K) int32 {
+	if m.x != nil {
+		if m.x.idx != nil {
+			if i, ok := m.x.idx[k]; ok {
+				return i
+			}
+			return -1
+		}
+		for i, x := range m.keys {
+			if x == k && !m.isDead(i) {
+				return int32(i)
+			}
+		}
+		return -1
+	}
+	for i, x := range m.keys {
+		if x == k {
+			return int32(i)
+		}
+	}
+	return -1
+}
+
+func (m *TMap[K, V]) size() int32   { return m.live }
+func (m *TMap[K, V]) isEmpty() bool { return m.live == 0 }
+
+func (m *TMap[K, V]) get(k K) V {
+	if i := m.find(k); i >= 0 {
+		return m.vals[i]
+	}
+	return m.vc.null
+}
+
+func (m *TMap[K, V]) containsKey(k K) bool { return m.find(k) >= 0 }
+
+func (m *TMap[K, V]) getOrDefault(k K, def V) V {
+	if i := m.find(k); i >= 0 {
+		return m.vals[i]
+	}
+	return def
+}
+
+// put stores v under k and returns the previous value (null if there was none).
+func (m *TMap[K, V]) put(k K, v V) V {
+	if m.imm {
+		throwUOE_()
+	}
+	if i := m.find(k); i >= 0 {
+		old := m.vals[i]
+		m.vals[i] = v
+		return old
+	}
+	if m.keys == nil {
+		m.keys = make([]K, 0, 4) // as the runtime's tables: most stay this small
+		m.vals = make([]V, 0, 4)
+	}
+	m.keys = append(m.keys, k)
+	m.vals = append(m.vals, v)
+	n := int32(len(m.keys) - 1)
+	m.live++
+	if x := m.x; x != nil {
+		if x.dead != nil {
+			x.dead = append(x.dead, false)
+		}
+		if x.idx != nil {
+			x.idx[k] = n
+			return m.vc.null
+		}
+	}
+	if len(m.keys) > tsmall_ {
+		m.reindex()
+	}
+	return m.vc.null
+}
+
+func (m *TMap[K, V]) reindex() {
+	x := m.ext()
+	x.idx = make(map[K]int32, len(m.keys))
+	for i, k := range m.keys {
+		if !m.isDead(i) {
+			x.idx[k] = int32(i)
+		}
+	}
+}
+
+func (m *TMap[K, V]) putIfAbsent(k K, v V) V {
+	if i := m.find(k); i >= 0 {
+		if old := m.vals[i]; !m.vc.isNull(old) {
+			return old
+		}
+	}
+	return m.put(k, v)
+}
+
+// remove deletes the mapping of k and returns its value (null if there was none).
+func (m *TMap[K, V]) remove(k K) V {
+	if m.imm {
+		throwUOE_()
+	}
+	i := m.find(k)
+	if i < 0 {
+		return m.vc.null
+	}
+	return m.removeAt(i)
+}
+
+func (m *TMap[K, V]) removeAt(i int32) V {
+	old := m.vals[i]
+	var zk K
+	var zv V
+	x := m.ext()
+	if x.idx != nil {
+		delete(x.idx, m.keys[i])
+	}
+	if x.dead == nil {
+		x.dead = make([]bool, len(m.keys), cap(m.keys))
+	}
+	x.dead[i] = true
+	m.keys[i] = zk
+	m.vals[i] = zv
+	m.live--
+	x.ndead++
+	if x.ndead > tsmall_ && x.ndead > m.live {
+		m.compact()
+	}
+	return old
+}
+
+func (m *TMap[K, V]) compact() {
+	j := 0
+	for i := range m.keys {
+		if !m.isDead(i) {
+			m.keys[j], m.vals[j] = m.keys[i], m.vals[i]
+			j++
+		}
+	}
+	var zk K
+	var zv V
+	for i := j; i < len(m.keys); i++ {
+		m.keys[i], m.vals[i] = zk, zv
+	}
+	m.keys, m.vals = m.keys[:j], m.vals[:j]
+	m.x.dead, m.x.ndead = nil, 0
+	if m.x.idx != nil {
+		m.reindex()
+	}
+}
+
+func (m *TMap[K, V]) clear() {
+	if m.imm {
+		throwUOE_()
+	}
+	clear(m.keys)
+	clear(m.vals)
+	m.keys, m.vals = m.keys[:0], m.vals[:0]
+	m.live = 0
+	if m.x != nil {
+		m.x.dead, m.x.idx, m.x.ndead = nil, nil, 0
+	}
+}
+
+// computeIfAbsent is Map.computeIfAbsent with an erased function.
+func (m *TMap[K, V]) computeIfAbsent(k K, f Function_e) V {
+	if i := m.find(k); i >= 0 && !m.vc.isNull(m.vals[i]) {
+		return m.vals[i]
+	}
+	r := f.apply(m.kc.box(k))
+	if r == nil {
+		return m.vc.null
+	}
+	v := m.vc.unbox(r)
+	m.put(k, v)
+	return v
+}
+
+// each is the cursor of a for-each loop over the entries (keys, values) of the map.
+func (m *TMap[K, V]) each() tmapEach_[K, V] { return tmapEach_[K, V]{m: m} }
+
+type tmapEach_[K comparable, V any] struct {
+	m *TMap[K, V]
+	i int
+	k K
+	v V
+}
+
+func (e *tmapEach_[K, V]) next() bool {
+	m := e.m
+	for e.i < len(m.keys) {
+		i := e.i
+		e.i++
+		if !m.isDead(i) {
+			e.k, e.v = m.keys[i], m.vals[i]
+			return true
+		}
+	}
+	return false
+}
+
+// ---- sets
+
+type TSet[K comparable] struct {
+	TMap[K, struct{}]
+}
+
+var tunit_ = &tconv_[struct{}]{box: func(struct{}) any { return nil }, unbox: func(any) struct{} { return struct{}{} }}
+
+func newTSet_[K comparable](kc *tconv_[K]) *TSet[K] {
+	return &TSet[K]{TMap: TMap[K, struct{}]{kc: kc, vc: tunit_}}
+}
+
+// tsetFrom_ is new LinkedHashSet<>(from) (or an ImmutableSet, imm) as a typed set.
+func tsetFrom_[K comparable](kc *tconv_[K], from Collection, imm bool) *TSet[K] {
+	if imm && isNil_(from) {
+		return nil
+	}
+	s := newTSet_(kc)
+	for _, x := range toSlice_(from) {
+		s.add(kc.unbox(x))
+	}
+	s.imm = imm
+	return s
+}
+
+func (s *TSet[K]) add(k K) bool {
+	if s.imm {
+		throwUOE_()
+	}
+	if s.find(k) >= 0 {
+		return false
+	}
+	s.put(k, struct{}{})
+	return true
+}
+
+func (s *TSet[K]) contains(k K) bool { return s.find(k) >= 0 }
+
+func (s *TSet[K]) remove(k K) bool {
+	if s.imm {
+		throwUOE_()
+	}
+	i := s.find(k)
+	if i < 0 {
+		return false
+	}
+	s.removeAt(i)
+	return true
+}
+
+func (s *TSet[K]) each() tsetEach_[K] { return tsetEach_[K]{m: &s.TMap} }
+
+type tsetEach_[K comparable] struct {
+	m *TMap[K, struct{}]
+	i int
+	v K
+}
+
+func (e *tsetEach_[K]) next() bool {
+	m := e.m
+	for e.i < len(m.keys) {
+		i := e.i
+		e.i++
+		if !m.isDead(i) {
+			e.v = m.keys[i]
+			return true
+		}
+	}
+	return false
+}
+
+// ---- the erased faces
+
+// try unboxes v, or reports that v is not a T (a lookup with a key of another class).
+func (c *tconv_[T]) try(v any) (r T, ok bool) {
+	defer func() {
+		if recover() != nil {
+			ok = false
+		}
+	}()
+	return c.unbox(v), true
+}
+
+func (c *tconv_[T]) isNull(v T) bool { return any(v) == any(c.null) }
+
+func (m *TMap[K, V]) asMap() Map {
+	if m == nil {
+		return nil
+	}
+	x := m.ext()
+	if x.view == nil {
+		x.view = &tmapView_[K, V]{m: m}
+	}
+	return x.view
+}
+
+func (s *TSet[K]) asSet() Set {
+	if s == nil {
+		return nil
+	}
+	x := s.ext()
+	if x.sview == nil {
+		x.sview = &tsetView_[K]{m: &s.TMap}
+	}
+	return x.sview
+}
+
+type tmapView_[K comparable, V any] struct{ m *TMap[K, V] }
+
+func (v *tmapView_[K, V]) self() any     { return v }
+func (v *tmapView_[K, V]) size() int32   { return v.m.live }
+func (v *tmapView_[K, V]) isEmpty() bool { return v.m.live == 0 }
+func (v *tmapView_[K, V]) clear()        { v.m.clear() }
+func (v *tmapView_[K, V]) get(k any) any {
+	if kk, ok := v.m.kc.try(k); ok {
+		if i := v.m.find(kk); i >= 0 {

diff --git a/go/closure/rt_cmp_test.go b/go/closure/rt_cmp_test.go
index 4d50ecd3..957026c5 100644
--- a/go/closure/rt_cmp_test.go
+++ b/go/closure/rt_cmp_test.go
@@ -75,3 +75,29 @@ func TestComparatorCombinatorsKeepCallOrder(t *testing.T) {
 		t.Errorf("thenComparing does not break ties with its second comparator")
 	}
 }
+
+// tcmpEnum_ is an enum type of the program's shape without its own compareTo (post-flip enumcmp
+// deletes the forwarders): the natural order compares it by java.lang.Enum's compareTo.
+type tcmpEnum_ uint8
+
+var tcmpEnum_enum_ = [3]Enum{{name_: "A", ordinal_: 0}, {name_: "B", ordinal_: 1}, {name_: "C", ordinal_: 2}}
+
+func (this tcmpEnum_) enum_() *Enum {
+	if this == 0 {
+		return nil
+	}
+	return &tcmpEnum_enum_[this-1]
+}
+
+func (this tcmpEnum_) ordinal() int32 { return this.enum_().ordinal_ }
+
+func TestCompareNaturalEnum(t *testing.T) {
+	for a := tcmpEnum_(1); a <= 3; a++ {
+		for b := tcmpEnum_(1); b <= 3; b++ {
+			want := a.enum_().compareTo(b)
+			if got := compareNatural_(a, b); got != want || (got < 0) != (a < b) || (got == 0) != (a == b) {
+				t.Errorf("compareNatural_(%d, %d) = %d, want %d", a, b, got, want)
+			}
+		}
+	}
+}
diff --git a/go/closure/rt_coll.go b/go/closure/rt_coll.go
index e2919a35..d3eda78b 100644
--- a/go/closure/rt_coll.go
+++ b/go/closure/rt_coll.go
@@ -1605,6 +1605,10 @@ func compareNatural_(a, b any) int32 {
 		return -1
 	case interface{ compareTo(any) int32 }:
 		return x.compareTo(b)
+	case interface{ enum_() *Enum }:
+		// an enum type of the program: java.lang.Enum's final compareTo (post-flip enumcmp
+		// deletes the per-enum forwarders)
+		return x.enum_().compareTo(b)
 	}
 	panic(new_ClassCastException_String(goTypeName_(a) + " is not Comparable").self())
 }

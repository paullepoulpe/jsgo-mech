+		}
+		return
+	}
+	if 2*len(m.keys) > len(x.slots) {
+		m.reindexH()
+		return
+	}
+	m.placeH(hmix_(h), n)
+}
+
+func (m *TMap[K, V]) placeH(hv uint32, i int32) {
+	x := m.x
+	mask := uint32(len(x.slots) - 1)
+	j := hv & mask
+	for x.slots[j] != 0 {
+		j = (j + 1) & mask
+	}
+	x.slots[j] = uint64(hv)<<32 | uint64(uint32(i+1))
+}

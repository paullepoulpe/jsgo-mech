diff --git a/go/closure/rt_iter.go b/go/closure/rt_iter.go
index 1299212f..27234165 100644
--- a/go/closure/rt_iter.go
+++ b/go/closure/rt_iter.go
@@ -156,3 +156,30 @@ func immElems_(c *ImmutableCollection) []any {
 	}
 	return c.elems_()
 }
+
+// immCursor_ is an explicit iterator over an immutable collection (post-flip step iters): the
+// translated code's hasNext/next/remove on it mean what they meant on the collection's own
+// iterator (ImmutableCollection.iterator, a sliceIter_ over its elements), but it is a typed
+// pointer, so a function that only advances it keeps it on the stack.
+type immCursor_ struct {
+	items []any
+	i     int
+}
+
+// immCursorOf_ is c.iterator(): the elements in iteration order (a multiset's with their
+// repetitions); a null c throws NullPointerException as calling c.iterator() did.
+func immCursorOf_(c *ImmutableCollection) *immCursor_ { return &immCursor_{items: c.elems_()} }
+
+func (it *immCursor_) hasNext() bool { return it.i < len(it.items) }
+
+func (it *immCursor_) next() any {
+	if it.i >= len(it.items) {
+		panic(new_NoSuchElementException_0().self())
+	}
+	v := it.items[it.i]
+	it.i++
+	return v
+}
+
+// remove throws UnsupportedOperationException, as an immutable collection's iterator does.
+func (it *immCursor_) remove() { throwUOE_() }
diff --git a/go/closure/rt_iter_test.go b/go/closure/rt_iter_test.go
index cdd67aa0..ae06dc42 100644
--- a/go/closure/rt_iter_test.go
+++ b/go/closure/rt_iter_test.go
@@ -241,3 +241,30 @@ func sameInts_(a, b []int32) bool {
 	}
 	return true
 }
+
+// TestImmCursorMatchesIterator walks immutable lists and sets (empty, with duplicates folded
+// by the set) with immCursorOf_ and with the collection's own iterator: same elements, then
+// NoSuchElementException from next at the end; remove throws UnsupportedOperationException.
+func TestImmCursorMatchesIterator(t *testing.T) {
+	throws := func(f func()) (thrown bool) {
+		defer func() { thrown = recover() != nil }()
+		f()
+		return false
+	}
+	for _, c := range []*ImmutableCollection{
+		immList_(nil), immList_([]any{"a", "b", "a"}), immSet_([]any{"a", "b", "a", "c"}),
+	} {
+		it, cur := c.iterator(), immCursorOf_(c)
+		for it.hasNext() {
+			if !cur.hasNext() || cur.next() != it.next() {
+				t.Fatalf("cursor differs from iterator over %v", c.elems_())
+			}
+		}
+		if cur.hasNext() || !throws(func() { cur.next() }) || !throws(func() { cur.remove() }) {
+			t.Fatalf("cursor end differs over %v", c.elems_())
+		}
+	}
+	if !throws(func() { immElems_(nil) }) || !throws(func() { immCursorOf_(nil) }) {
+		t.Fatal("a null immutable collection does not throw")
+	}
+}

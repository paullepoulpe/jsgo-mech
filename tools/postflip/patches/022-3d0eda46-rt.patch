+// varList is keySet() as an erased list of the variables, in insertion order.
+func (m *varMap_[V]) varList() List {
+	items := make([]any, len(m.vars))
+	for i, v := range m.vars {
+		items[i] = v.self()
+	}
+	return listOf_(items)
+}

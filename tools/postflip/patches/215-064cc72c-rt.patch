+// ttreeStrCmp_ is natural ordering of strings (a function, so a map or set made with it
+// allocates no closure); a null string goes through compareNatural_ as a boxed null did.
+func ttreeStrCmp_(a, b string) int32 {
+	if a == nullstr_ || b == nullstr_ {
+		return compareNatural_(strobj_(a), strobj_(b))
+	}
+	return String_compareTo(a, b)
+}

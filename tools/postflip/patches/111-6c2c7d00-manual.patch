+			if var_ := scope.vars.lookup(name, &h); var_ != nil {
 				return var_
 			}
+			if imp != 0 {
+				if var_ := scope.getOwnImplicitSlot(imp); var_ != nil {
+					return var_
+				}
+			}
 		}
 	}
 	return nil

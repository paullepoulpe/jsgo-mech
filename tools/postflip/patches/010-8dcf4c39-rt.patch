diff --git a/go/closure/rt_tlist.go b/go/closure/rt_tlist.go
index 566984ed..2b6da915 100644
--- a/go/closure/rt_tlist.go
+++ b/go/closure/rt_tlist.go
@@ -34,11 +34,26 @@ func tlistImm_[T any](c *tconv_[T], from Collection) *TList[T] {
 	if isNil_(from) {
 		return nil
 	}
+	k := immKey_{from, c}
+	if v, ok := immCache_[k]; ok {
+		return v.(*TList[T])
+	}
 	l := tlistFrom_(c, from)
 	l.imm = true
+	immCache_[k] = l
 	return l
 }
 
+// immCache_ holds the typed copy of each immutable collection that was converted: an
+// ImmutableList/Set/Map never changes, so a long-lived one (a constant passed on every call)
+// is copied once, and the same object comes back each time, as the erased code shared it.
+var immCache_ = map[immKey_]any{}
+
+type immKey_ struct {
+	from any // the erased immutable collection
+	conv any // the element conversion (the typed copy's element type)
+}
+
 // tlistFrom_ is new ArrayList<>(from) as a typed list.
 func tlistFrom_[T any](c *tconv_[T], from Collection) *TList[T] {
 	src := toSlice_(from)
diff --git a/go/closure/rt_tmap.go b/go/closure/rt_tmap.go
index 00e92fe1..b0c0257a 100644
--- a/go/closure/rt_tmap.go
+++ b/go/closure/rt_tmap.go
@@ -50,12 +50,21 @@ func tmapFrom_[K comparable, V any](kc *tconv_[K], vc *tconv_[V], from Map, imm
 	if imm && isNil_(from) {
 		return nil
 	}
+	k := immKey_{from, [2]any{kc, vc}}
+	if imm {
+		if v, ok := immCache_[k]; ok {
+			return v.(*TMap[K, V])
+		}
+	}
 	m := newTMap_(kc, vc)
 	for it := from.entrySet().iterator(); it.hasNext(); {
 		e := it.next().(Map_Entry)
 		m.put(kc.unbox(e.getKey()), vc.unbox(e.getValue()))
 	}
 	m.imm = imm
+	if imm {
+		immCache_[k] = m
+	}
 	return m
 }
 
@@ -274,11 +283,20 @@ func tsetFrom_[K comparable](kc *tconv_[K], from Collection, imm bool) *TSet[K]
 	if imm && isNil_(from) {
 		return nil
 	}
+	k := immKey_{from, kc}
+	if imm {
+		if v, ok := immCache_[k]; ok {
+			return v.(*TSet[K])
+		}
+	}
 	s := newTSet_(kc)
 	for _, x := range toSlice_(from) {
 		s.add(kc.unbox(x))
 	}
 	s.imm = imm
+	if imm {
+		immCache_[k] = s
+	}
 	return s
 }
 

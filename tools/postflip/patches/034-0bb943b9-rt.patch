@@ -1698,6 +1698,12 @@ func Map_get_s(m any, k string) any {
 		if im, ok := m.(*ImmutableMap); ok && im != nil {
 			return im.get_s(k)
 		}
+		if tm, ok := m.(*TreeMap); ok && tm.strKeyed() {
+			if i, ok := tm.search_s(k); ok {

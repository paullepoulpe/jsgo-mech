+// catchNilAssert_ reports whether a runtime error is a type assertion of a nil interface value. A
+// Java cast passes null, so such an assertion is a cast whose value is dereferenced at once
+// (castfold -assert writes `((X) v).f` as v.(*X).f): Java's NullPointerException at the
+// dereference, not a ClassCastException.
+func catchNilAssert_(e runtime.Error) bool {
+	te, ok := e.(*runtime.TypeAssertionError)
+	return ok && strings.Contains(te.Error(), " is nil, not ")
+}

+func (m *TMap[K, V]) computeIfAbsent(k K, f Function) V {
+	if i := m.find(k); i >= 0 && !m.vc.isNull(m.vals[i]) {
+		return m.vals[i]
+	}
+	r := f.apply(m.kc.box(k))
+	if r == nil {
+		return m.vc.null
+	}
+	v := m.vc.unbox(r)
+	m.put(k, v)
+	return v
+}
 

@@ -0,0 +1,42 @@
+package closure
+
+// LinkedIdentityHashMap's methods on a typed map (post-flip step colls -kind idmap).
+//
+// com.google.javascript.jscomp.base.LinkedIdentityHashMap is an identity hash map in insertion
+// order without removal. colls types one whose keys are pointers as a *TMap[K, V]: Go's == on
+// pointers is identity, and a TMap keeps insertion order. get and put are the TMap's (a
+// missing key reads as null, put returns null for a new key, as LinkedIdentityHashMap's do);
+// the methods below are LinkedIdentityHashMap's own, which differ from Map's default methods
+// (computeIfAbsent stores a null result, merge stores the value when the key reads as null).
+
+// lihmComputeIfAbsent_ is LinkedIdentityHashMap.computeIfAbsent: the value if non-null, else
+// fn(key), stored even when null.
+func lihmComputeIfAbsent_[K comparable, V any](m *TMap[K, V], k K, fn func(any) any) V {
+	if old := m.get(k); !m.vc.isNull(old) {
+		return old
+	}
+	v := m.vc.unbox(fn(m.kc.box(k)))
+	m.put(k, v)
+	return v
+}
+
+// lihmMerge_ is LinkedIdentityHashMap.merge: value when the key reads as null, else
+// fn(old, value); stored either way.
+func lihmMerge_[K comparable, V any](m *TMap[K, V], k K, value V, fn func(any, any) any) V {
+	old := m.get(k)
+	if m.vc.isNull(old) {
+		m.put(k, value)
+		return value
+	}
+	v := m.vc.unbox(fn(m.vc.box(old), m.vc.box(value)))
+	m.put(k, v)
+	return v
+}
+
+// lihmForEach_ is LinkedIdentityHashMap.forEach: fn(key, value) in insertion order, reading the
+// entries anew at every step (it walked its entry list the same way).
+func lihmForEach_[K comparable, V any](m *TMap[K, V], fn func(any, any)) {
+	for e := m.each(); e.next(); {
+		fn(m.kc.box(e.k), m.vc.box(e.v))
+	}
+}
diff --git a/go/closure/rt_idmap_test.go b/go/closure/rt_idmap_test.go
new file mode 100644
index 00000000..720918d9
--- /dev/null
+++ b/go/closure/rt_idmap_test.go
@@ -0,0 +1,78 @@
+package closure
+
+import (
+	"math/rand"
+	"testing"
+)
+
+// TestLihmAgainstLinkedIdentityHashMap checks LinkedIdentityHashMap's methods on a typed map
+// (rt_idmap.go) against the translated class, with null results and values.
+func TestLihmAgainstLinkedIdentityHashMap(t *testing.T) {
+	type key struct{ n int }
+	keys := make([]*key, 8)
+	for i := range keys {
+		keys[i] = &key{i % 3} // equal fields, distinct identities
+	}
+	kc := &tconv_[*key]{box: func(v *key) any { return obj_(v) }, unbox: func(v any) *key { return cast_[*key](v) }}
+	vc := &tconv_[any]{box: func(v any) any { return v }, unbox: func(v any) any { return v }}
+	r := rand.New(rand.NewSource(11))
+	for round := 0; round < 200; round++ {
+		m, tm := new_LinkedIdentityHashMap(), newTMap_(kc, vc)
+		for op := 0; op < 30; op++ {
+			k := keys[r.Intn(len(keys))]
+			var v any
+			if x := r.Intn(4); x > 0 {
+				v = any(int32(x))
+			}
+			fn := func(any) any { return v }
+			mf := func(a, b any) any {
+				if a == nil {
+					return b
+				}
+				return any(a.(int32) + 10)
+			}
+			var a, b any
+			switch r.Intn(4) {
+			case 0:
+				a, b = m.get(obj_(k)), tm.get(k)
+			case 1:
+				a, b = m.put(obj_(k), v), tm.put(k, v)
+			case 2:
+				a, b = m.computeIfAbsent(obj_(k), fn), lihmComputeIfAbsent_(tm, k, fn)
+			case 3:
+				if v != nil {
+					a, b = m.merge(obj_(k), v, mf), lihmMerge_(tm, k, v, mf)
+				}
+			}
+			if a != b {
+				t.Fatalf("round %d op %d: %v != %v", round, op, a, b)
+			}
+		}
+		var want, got []any
+		m.forEach(func(k, v any) { want = append(want, k, v) })
+		lihmForEach_(tm, func(k, v any) { got = append(got, k, v) })
+		if len(want) != len(got) {
+			t.Fatalf("round %d: forEach %v != %v", round, want, got)
+		}
+		for i := range want {
+			if want[i] != got[i] {
+				t.Fatalf("round %d: forEach %v != %v", round, want, got)
+			}
+		}
+	}
+}
+
+// TestTlistFromRev checks a deque's copy as a list whose end is its head.
+func TestTlistFromRev(t *testing.T) {
+	src := listOf_([]any{"a", "b", "c"})
+	d := new_ArrayDeque_Collection(src)
+	l := tlistFromRev_(tcTreeStr_, src)
+	for !d.isEmpty() {
+		if str_(d.pop()) != l.pop_() {
+			t.Fatal("pop order differs")
+		}
+	}
+	if len(l.items) != 0 {
+		t.Fatal("lengths differ")
+	}
+}
